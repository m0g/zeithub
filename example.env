# SQLite database file (created on first start, migrations run automatically)
DATABASE_PATH=.data/zeithub.db

# Seals the session cookie. Required in production (32+ characters); in
# development one is generated for you. Generate one with:
#   openssl rand -base64 32
# NUXT_APP_SECRET=

# Session cookies are "Secure" (HTTPS only, localhost excepted). Uncomment
# if you serve Zeithub over plain HTTP on a LAN address.
# NUXT_SESSION_COOKIE_SECURE=false

# Chromium/Chrome binary used to render invoice PDFs
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Debian/Ubuntu: /usr/bin/chromium
CHROME_BIN=/usr/bin/chromium
